# Database
CREDIBIL_DATABASE_URL=postgresql+asyncpg://credibil:credibil@localhost:5432/credibil
DB_PASSWORD=change-me

# Redis
CREDIBIL_REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=change-me

# JWT
CREDIBIL_JWT_SECRET=change-me-in-production

# Search
CREDIBIL_MEILISEARCH_URL=http://localhost:7700
CREDIBIL_MEILISEARCH_API_KEY=dev-master-key
MEILISEARCH_MASTER_KEY=dev-master-key

# CORS
CREDIBIL_CORS_ORIGINS=http://localhost:5173

# Rate limiting
CREDIBIL_RATE_LIMIT_RPM=60
CREDIBIL_RATE_LIMIT_RPH=1000

# Telemetry
CREDIBIL_OTEL_EXPORTER_ENDPOINT=

# App
CREDIBIL_DEBUG=true
CREDIBIL_LOG_LEVEL=INFO

# Sanctions (SDN API)
CREDIBIL_SDN_API_KEY=your-api-key-here
CREDIBIL_SDN_API_URL=http://compliance.dazor.by/api/v1
